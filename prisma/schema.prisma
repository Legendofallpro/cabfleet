// CabFleet Prisma schema
// See plan: src/.cursor/plans/cabfleet_architecture_plan_*.plan.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// Enums
// =========================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  DRIVER
  CUSTOMER
}

enum DriverStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  INACTIVE
}

enum DriverVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  INACTIVE
}

enum VehicleType {
  SEDAN
  SUV
  HATCHBACK
  MINIVAN
  LUXURY
  TEMPO
  OTHER
}

enum StaffDesignation {
  MANAGER
  DISPATCHER
  SUPPORT
  ACCOUNTANT
  OTHER
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  STATUS_CHANGE
  ASSIGN
  UNASSIGN
  CLAIM
  CANCEL
  COMPLETE
}

// Booking enums (Phase 2, defined now to avoid migrations later)
enum BookingStatus {
  PENDING
  OPEN_FOR_CLAIM
  CLAIMED
  ASSIGNED
  DRIVER_EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
  NO_SHOW
}

// Notifications (Phase 7 W2)
enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
}

enum DispatchMode {
  MANUAL
  CLAIM
  HYBRID
}

// =========================================================
// Tenant scoping
// =========================================================

// Top-level tenant. Every tenant-scoped row carries `orgId` and is filtered by
// the Prisma extension in src/lib/db.ts. Profile.orgId is intentionally nullable
// so SUPER_ADMIN profiles can act across orgs (enforced via a CHECK constraint
// added in the W1 migration). See [docs/architecture.md] §13 Phase 7 and the
// W1 section of the Phase 7 plan.
model Organization {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  /// Indian GSTIN. Optional — invoices omit the GSTIN line when null.
  gstin     String?
  /// Snapshot source for invoices. Allowed values: 0, 5, 12. Rate 0 hides tax lines.
  gstRate   Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches           Branch[]
  profiles           Profile[]
  drivers            Driver[]
  staff              Staff[]
  customers          Customer[]
  vehicles           Vehicle[]
  vehicleAssignments VehicleAssignment[]
  bookingTypes       BookingType[]
  bookings           Booking[]
  pricingRules       PricingRule[]
  dispatchRules      DispatchRule[]
  payments           Payment[]
  refunds            Refund[]
  invoices           Invoice[]
  shifts             Shift[]
  tripLocations      TripLocation[]
  attendance         Attendance[]
  fuelLogs           FuelLog[]
  expenses           Expense[]
  maintenanceLogs    MaintenanceLog[]
  assignmentHistory  AssignmentHistory[]
  auditLogs          AuditLog[]
  notificationOutbox NotificationOutbox[]
  notificationLogs   NotificationLog[]

  @@index([deletedAt])
}

model Branch {
  id              String       @id @default(cuid())
  orgId           String?
  name            String
  code            String       @unique
  timezone        String       @default("UTC")
  address         String?
  phone           String?
  email           String?
  // Default dispatch mode for bookings in this branch (overridable per BookingType / rule)
  defaultDispatch DispatchMode @default(MANUAL)
  active          Boolean      @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org           Organization?  @relation(fields: [orgId], references: [id])
  profiles      Profile[]
  vehicles      Vehicle[]
  bookings      Booking[]
  pricingRules  PricingRule[]
  dispatchRules DispatchRule[]
  shifts        Shift[]

  @@index([orgId])
  @@index([active])
  @@index([deletedAt])
}

// =========================================================
// Identity
// =========================================================

// Mirrors Supabase auth.users 1:1. Synced via a Postgres trigger
// (see prisma/sql/01_profile_sync.sql).
model Profile {
  // Equal to auth.users.id (Supabase UUID)
  id                String  @id @db.Uuid
  // Null only for SUPER_ADMIN (cross-org platform admins). Enforced by a CHECK
  // constraint added in the W1 migration: orgId IS NOT NULL OR role = 'SUPER_ADMIN'.
  orgId             String?
  email             String  @unique
  fullName          String?
  phone             String? @unique
  avatarUrl         String?
  role              Role    @default(CUSTOMER)
  branchId          String?
  // Notification preferences (Phase 7 W2). Free-form JSON so the shape can
  // evolve without a migration. Defaults applied in NotificationService when
  // unset. Expected keys: { whatsapp: boolean, email: boolean,
  // quietHoursStart: "HH:MM", quietHoursEnd: "HH:MM", timezone: string }.
  notificationPrefs Json?
  // BCP-47 locale used to pick localized templates. v1 only ships en-IN.
  locale            String  @default("en-IN")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org       Organization? @relation(fields: [orgId], references: [id])
  branch    Branch?       @relation(fields: [branchId], references: [id])
  driver    Driver?
  staff     Staff?
  customer  Customer?
  auditLogs AuditLog[]    @relation("AuditActor")

  // Bookings/assignments created/owned by this profile
  bookingsCreated   Booking[]           @relation("BookingCreatedBy")
  bookingsAssigned  Booking[]           @relation("BookingAssignedBy")
  assignmentHistory AssignmentHistory[]
  paymentsCreated   Payment[]           @relation("PaymentCreatedBy")
  refundsRequested  Refund[]            @relation("RefundRequestedBy")
  refundsApproved   Refund[]            @relation("RefundApprovedBy")
  attendance        Attendance[]
  expenses          Expense[]

  @@index([orgId])
  @@index([role])
  @@index([branchId])
  @@index([deletedAt])
}

// =========================================================
// Driver
// =========================================================

model Driver {
  id            String                   @id @default(cuid())
  orgId         String?
  profileId     String                   @unique @db.Uuid
  licenseNumber String                   @unique
  licenseExpiry DateTime
  status        DriverStatus             @default(ACTIVE)
  verification  DriverVerificationStatus @default(UNVERIFIED)
  rating        Float?
  totalTrips    Int                      @default(0)
  notes         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org                Organization?       @relation(fields: [orgId], references: [id])
  profile            Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  vehicleAssignments VehicleAssignment[]
  claimedBookings    Booking[]           @relation("BookingClaimedBy")
  assignedBookings   Booking[]           @relation("BookingAssignedDriver")
  fuelLogs           FuelLog[]

  @@index([orgId])
  @@index([status])
  @@index([verification])
  @@index([deletedAt])
}

// =========================================================
// Staff
// =========================================================

model Staff {
  id          String           @id @default(cuid())
  orgId       String?
  profileId   String           @unique @db.Uuid
  employeeId  String           @unique
  designation StaffDesignation @default(SUPPORT)
  status      StaffStatus      @default(ACTIVE)
  hiredAt     DateTime         @default(now())
  notes       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org     Organization? @relation(fields: [orgId], references: [id])
  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  shifts  Shift[]

  @@index([orgId])
  @@index([status])
  @@index([designation])
  @@index([deletedAt])
}

// =========================================================
// Customer
// =========================================================

model Customer {
  id            String  @id @default(cuid())
  orgId         String?
  profileId     String  @unique @db.Uuid
  address       String?
  defaultPickup String?
  loyaltyTier   String?
  totalBookings Int     @default(0)
  totalSpend    Decimal @default(0) @db.Decimal(12, 2)
  /// Desk-created guest with a synthetic email; cannot use /portal until invited.
  staffManaged  Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org      Organization? @relation(fields: [orgId], references: [id])
  profile  Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([orgId])
  @@index([deletedAt])
}

// =========================================================
// Vehicles
// =========================================================

model Vehicle {
  id                 String        @id @default(cuid())
  orgId              String?
  branchId           String
  registrationNumber String        @unique
  make               String
  model              String
  year               Int
  color              String?
  type               VehicleType   @default(SEDAN)
  capacity           Int           @default(4)
  status             VehicleStatus @default(AVAILABLE)
  insuranceExpiry    DateTime?
  fitnessExpiry      DateTime?
  pucExpiry          DateTime?
  odometer           Int           @default(0)
  notes              String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org              Organization?       @relation(fields: [orgId], references: [id])
  branch           Branch              @relation(fields: [branchId], references: [id])
  assignments      VehicleAssignment[]
  assignedBookings Booking[]           @relation("BookingAssignedVehicle")
  fuelLogs         FuelLog[]
  expenses         Expense[]
  maintenanceLogs  MaintenanceLog[]

  @@index([orgId])
  @@index([branchId])
  @@index([status])
  @@index([deletedAt])
}

model VehicleAssignment {
  id        String    @id @default(cuid())
  orgId     String?
  driverId  String
  vehicleId String
  validFrom DateTime  @default(now())
  validTo   DateTime?

  org     Organization? @relation(fields: [orgId], references: [id])
  driver  Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([validTo])
}

// =========================================================
// Bookings (Phase 2; schema seeded now for stability)
// =========================================================

model BookingType {
  id                  String       @id @default(cuid())
  orgId               String?
  name                String       @unique
  description         String?
  defaultDispatchMode DispatchMode @default(MANUAL)
  active              Boolean      @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org           Organization?  @relation(fields: [orgId], references: [id])
  pricingRules  PricingRule[]
  dispatchRules DispatchRule[]
  bookings      Booking[]

  @@index([orgId])
}

model Booking {
  id            String        @id @default(cuid())
  orgId         String?
  branchId      String
  customerId    String
  bookingTypeId String
  status        BookingStatus @default(PENDING)
  dispatchMode  DispatchMode  @default(MANUAL)

  pickupAt        DateTime
  pickupAddress   String
  pickupLandmark  String?
  dropAddress     String
  dropLandmark    String?
  notes           String?
  // Geocoded coordinates. Added in W1 (cheaper to ship now than a second
  // migration in W5). Populated by GeocodingService in W5.
  pickupLat     Decimal? @db.Decimal(9, 6)
  pickupLng     Decimal? @db.Decimal(9, 6)
  dropLat       Decimal? @db.Decimal(9, 6)
  dropLng       Decimal? @db.Decimal(9, 6)
  distanceKm    Decimal? @db.Decimal(8, 2)
  passengers    Int      @default(1)

  // Claim
  claimTimeoutAt    DateTime?
  claimedAt         DateTime?
  claimedByDriverId String?

  // Assignment
  assignedAt        DateTime?
  assignedByStaffId String?   @db.Uuid
  assignedDriverId  String?
  assignedVehicleId String?

  // Money
  fareEstimate  Decimal? @db.Decimal(10, 2)
  fareFinal     Decimal? @db.Decimal(10, 2)
  tollAmount    Decimal  @default(0) @db.Decimal(10, 2)
  parkingAmount Decimal  @default(0) @db.Decimal(10, 2)

  // Concurrency control (optimistic locking; incremented on every transition)
  version Int @default(0)

  createdById String? @db.Uuid

  // ── Phase 7 W5: Realtime tracking ──────────────────────────────────
  /// §S15: timestamp when the customer accepted location tracking for
  /// this trip. NULL means "no consent recorded" and the ingest service
  /// refuses to accept location points.
  locationConsentAt DateTime?
  /// §S7: number of plausibility-flagged location points received for
  /// this booking. transitionBookingStatus blocks the COMPLETED move
  /// once this crosses LOCATION_SUSPICIOUS_THRESHOLD until a human
  /// clears it (admin override). Counter only grows; reset on a fresh
  /// booking.
  suspiciousLocationCount Int @default(0)
  /// §S15: compressed polyline (e.g. Google polyline algorithm at zoom
  /// 5) captured at COMPLETED time. Long-term summary that survives the
  /// 30-day TripLocation retention cron and is also wiped during DSR
  /// erasure.
  tripPolyline String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org               Organization?       @relation(fields: [orgId], references: [id])
  branch            Branch              @relation(fields: [branchId], references: [id])
  customer          Customer            @relation(fields: [customerId], references: [id])
  bookingType       BookingType         @relation(fields: [bookingTypeId], references: [id])
  claimedBy         Driver?             @relation("BookingClaimedBy", fields: [claimedByDriverId], references: [id])
  assignedDriver    Driver?             @relation("BookingAssignedDriver", fields: [assignedDriverId], references: [id])
  assignedVehicle   Vehicle?            @relation("BookingAssignedVehicle", fields: [assignedVehicleId], references: [id])
  assignedBy        Profile?            @relation("BookingAssignedBy", fields: [assignedByStaffId], references: [id])
  createdBy         Profile?            @relation("BookingCreatedBy", fields: [createdById], references: [id])
  assignmentHistory AssignmentHistory[]
  payments          Payment[]
  invoice           Invoice?
  tripLocations     TripLocation[]

  @@index([orgId])
  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([pickupAt])
  @@index([deletedAt])
}

/// §W5: live driver location points ingested via /api/v1/trips/:id/location.
///
/// Tenant-scoped (orgId) so the W1 Prisma extension auto-filters reads.
/// Rows are pruned daily by /api/cron/prune-trip-locations once they age
/// out of TRIP_LOCATION_RETENTION_DAYS (default 30). The long-term trip
/// summary (Booking.tripPolyline) is generated at COMPLETED time and
/// survives the prune.
model TripLocation {
  id          String   @id @default(cuid())
  orgId       String?
  bookingId   String
  /// Driver who emitted the point. Auth-checked in the route handler;
  /// stored here for forensic queries ("which driver pinged from
  /// outside the city last Tuesday?").
  driverId    String?
  lat         Decimal  @db.Decimal(9, 6)
  lng         Decimal  @db.Decimal(9, 6)
  /// Optional reported speed in km/h. NULL means "client didn't compute
  /// one"; the ingest service computes one from consecutive points
  /// when needed for plausibility (S7).
  speedKph    Decimal? @db.Decimal(6, 2)
  /// Wall-clock time the point was recorded on the device. We trust
  /// this only for ordering — plausibility uses server-side derived
  /// values.
  recordedAt  DateTime
  /// Server receive time — invariant for retention-cron filtering.
  createdAt   DateTime @default(now())
  /// §S7: true when this single point failed plausibility (speed cap,
  /// first-point distance, sudden jump). We still persist the row for
  /// forensics but it does NOT advance the customer-visible polyline.
  flagged     Boolean  @default(false)
  /// Audit string for why a point was flagged (which rule fired).
  flagReason  String?

  org     Organization? @relation(fields: [orgId], references: [id])
  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([bookingId, recordedAt])
  @@index([createdAt])
  @@index([driverId])
}

model AssignmentHistory {
  id          String      @id @default(cuid())
  orgId       String?
  bookingId   String
  driverId    String?
  vehicleId   String?
  action      AuditAction
  byProfileId String?     @db.Uuid
  reason      String?
  at          DateTime    @default(now())

  org       Organization? @relation(fields: [orgId], references: [id])
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  byProfile Profile?      @relation(fields: [byProfileId], references: [id])

  @@index([orgId])
  @@index([bookingId])
  @@index([at])
}

// =========================================================
// Pricing
// =========================================================

model PricingRule {
  id            String    @id @default(cuid())
  orgId         String?
  bookingTypeId String
  branchId      String?
  baseFare      Decimal   @default(0) @db.Decimal(10, 2)
  perKm         Decimal   @default(0) @db.Decimal(10, 2)
  perMin        Decimal   @default(0) @db.Decimal(10, 2)
  surgeJson     Json?
  validFrom     DateTime  @default(now())
  validTo       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org         Organization? @relation(fields: [orgId], references: [id])
  bookingType BookingType   @relation(fields: [bookingTypeId], references: [id])
  branch      Branch?       @relation(fields: [branchId], references: [id])

  @@index([orgId])
  @@index([bookingTypeId])
  @@index([branchId])
  @@index([validFrom, validTo])
}

// =========================================================
// Dispatch policy
// =========================================================

model DispatchRule {
  id              String       @id @default(cuid())
  orgId           String?
  priority        Int          @default(100) // lower = higher priority
  branchId        String?
  bookingTypeId   String?
  customerSegment String? // free-form tag for now (e.g. "corporate", "loyalty:gold")
  mode            DispatchMode
  params          Json? // e.g. { "hybridTimeoutMins": 5 }
  active          Boolean      @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org         Organization? @relation(fields: [orgId], references: [id])
  branch      Branch?       @relation(fields: [branchId], references: [id])
  bookingType BookingType?  @relation(fields: [bookingTypeId], references: [id])

  @@index([orgId])
  @@index([priority])
  @@index([active])
}

// =========================================================
// Payments (Phase 5)
// =========================================================

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(cuid())
  orgId           String?
  bookingId       String
  amount          Decimal       @db.Decimal(10, 2)
  method          String // e.g. "CASH", "CARD", "UPI"
  status          PaymentStatus @default(PENDING)
  // Phase 7 W3: provider's Order id (Razorpay creates an Order, then a Payment
  // against that Order). Set on charge(); webhook updates Payment.txnRef with
  // the captured payment id. Null for the MANUAL provider.
  providerOrderId String? @unique
  txnRef          String?
  capturedAt      DateTime?
  createdById     String?       @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org       Organization? @relation(fields: [orgId], references: [id])
  booking   Booking       @relation(fields: [bookingId], references: [id])
  createdBy Profile?      @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  refunds   Refund[]

  @@index([orgId])
  @@index([bookingId])
  @@index([status])
  @@index([deletedAt])
}

// Refund — Phase 7 W3 §7.5 S12.
//
// Refunds follow a four-eyes flow: one ADMIN (or SUPER_ADMIN) calls
// `requestRefund` to create a row in REQUESTED state; a DIFFERENT ADMIN
// calls `approveRefund` which actually triggers the provider refund + flips
// the row to PROCESSING / SUCCEEDED. The original Payment row is untouched
// (refunds are linked siblings, not in-place mutations) so the audit trail
// stays clean and reconcile cron can pair provider events to refund rows.
enum RefundStatus {
  REQUESTED
  REJECTED
  PROCESSING
  SUCCEEDED
  FAILED
}

model Refund {
  id               String       @id @default(cuid())
  orgId            String?
  paymentId        String
  amount           Decimal      @db.Decimal(10, 2)
  reason           String
  status           RefundStatus @default(REQUESTED)
  // Provider's refund id (e.g. rfnd_XYZ for Razorpay). Set when status
  // moves to PROCESSING. Used by the webhook handler to bind a refund.*
  // event back to this row.
  providerRefundId String? @unique
  // Four-eyes audit columns. requestedById must NOT equal approvedById —
  // enforced by `approveRefund` service.
  // Null for off-platform (Razorpay dashboard) refunds recorded by webhook.
  requestedById    String?      @db.Uuid
  approvedById     String?      @db.Uuid
  // Set when status transitions to SUCCEEDED via webhook.
  processedAt      DateTime?
  // Captures rejection reason or provider failure for forensics.
  failureReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org         Organization? @relation(fields: [orgId], references: [id])
  payment     Payment       @relation(fields: [paymentId], references: [id])
  requestedBy Profile?      @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  approvedBy  Profile?      @relation("RefundApprovedBy", fields: [approvedById], references: [id])

  @@index([orgId])
  @@index([paymentId])
  @@index([status])
}

// Webhook idempotency store (Phase 7 W3).
// One row per (provider, eventId). The Razorpay webhook route inserts a row
// before processing; a duplicate event hits the unique constraint and is
// silently 200 OK'd. Retention: minimum 90 days for replay-protection
// window — pruning deferred to a documented retention review.
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  receivedAt DateTime @default(now())
  payload    Json

  @@unique([provider, eventId])
  @@index([receivedAt])
}

// =========================================================
// Invoices (Phase 5)
// =========================================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

model Invoice {
  id        String        @id @default(cuid())
  orgId     String?
  bookingId String        @unique
  number    String        @unique
  pdfUrl    String?
  issuedAt  DateTime      @default(now())
  dueAt     DateTime?
  status    InvoiceStatus @default(DRAFT)
  /// GSTIN / rate / SAC snapshotted at issue time so later org edits don't rewrite history.
  gstin     String?
  gstRate   Int           @default(0)
  sacCode   String        @default("9964")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org     Organization? @relation(fields: [orgId], references: [id])
  booking Booking       @relation(fields: [bookingId], references: [id])

  @@index([orgId])
  @@index([status])
  @@index([issuedAt])
  @@index([deletedAt])
}

// =========================================================
// Operations (Phase 6)
// =========================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

model Attendance {
  id        String           @id @default(cuid())
  orgId     String?
  profileId String           @db.Uuid
  date      DateTime         @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  status    AttendanceStatus @default(PRESENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id])
  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@index([orgId])
  @@index([profileId])
  @@index([date])
}

model Shift {
  id       String   @id @default(cuid())
  orgId    String?
  branchId String
  staffId  String?
  startsAt DateTime
  endsAt   DateTime
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization? @relation(fields: [orgId], references: [id])
  branch Branch        @relation(fields: [branchId], references: [id])
  staff  Staff?        @relation(fields: [staffId], references: [id])

  @@index([orgId])
  @@index([branchId])
  @@index([staffId])
  @@index([startsAt])
}

model FuelLog {
  id        String   @id @default(cuid())
  orgId     String?
  vehicleId String
  driverId  String?
  litres    Decimal  @db.Decimal(8, 2)
  amount    Decimal  @db.Decimal(10, 2)
  odometer  Int
  notes     String?
  at        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id])
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id])
  driver  Driver?       @relation(fields: [driverId], references: [id])

  @@index([orgId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([at])
}

model Expense {
  id         String   @id @default(cuid())
  orgId      String?
  profileId  String?  @db.Uuid
  vehicleId  String?
  category   String // e.g. "MAINTENANCE", "FUEL", "TOLL", "MISC"
  amount     Decimal  @db.Decimal(10, 2)
  receiptUrl String?
  notes      String?
  at         DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id])
  profile Profile?      @relation(fields: [profileId], references: [id])
  vehicle Vehicle?      @relation(fields: [vehicleId], references: [id])

  @@index([orgId])
  @@index([profileId])
  @@index([vehicleId])
  @@index([at])
}

model MaintenanceLog {
  id              String   @id @default(cuid())
  orgId           String?
  vehicleId       String
  type            String // e.g. "SERVICE", "TYRE", "OIL_CHANGE", "REPAIR"
  cost            Decimal  @db.Decimal(10, 2)
  odometer        Int
  nextDueOdometer Int?
  notes           String?
  at              DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id])
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id])

  @@index([orgId])
  @@index([vehicleId])
  @@index([at])
}

// =========================================================
// Audit log (immutable; written by every mutation service)
// =========================================================

// =========================================================
// Notifications (Phase 7 W2)
// =========================================================

// Outbox row written inside the booking-mutation transaction. A 1-minute
// Vercel Cron at /api/cron/drain-notifications drains rows whose
// nextAttemptAt has passed, with exponential backoff (1m -> 5m -> 30m -> 2h)
// and a final DEAD_LETTER status after 4 failed attempts.
model NotificationOutbox {
  id            String                   @id @default(cuid())
  orgId         String?
  bookingId     String?
  templateId    String
  channel       NotificationChannel
  recipient     String
  // Shape: { variables: Record<string,string|number>, locale: string,
  //          urgent?: boolean }
  payload       Json
  status        NotificationOutboxStatus @default(PENDING)
  attempts      Int                      @default(0)
  nextAttemptAt DateTime                 @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  org Organization? @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([status, nextAttemptAt])
  @@index([bookingId])
}

// Permanent record of dispatch outcomes (one row per provider send attempt
// that produced a definitive SENT or FAILED result). The outbox row is what
// the cron drains; this is the audit trail surfaced in the admin viewer.
model NotificationLog {
  id                String              @id @default(cuid())
  orgId             String?
  bookingId         String?
  channel           NotificationChannel
  templateId        String
  recipient         String
  // "SENT" | "FAILED"
  status            String
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())

  org Organization? @relation(fields: [orgId], references: [id])

  @@index([orgId, status])
  @@index([bookingId])
  @@index([createdAt])
}

model AuditLog {
  id             String      @id @default(cuid())
  orgId          String?
  entity         String // "Booking", "Vehicle", ...
  entityId       String
  action         AuditAction
  diff           Json?
  byProfileId    String?     @db.Uuid
  // If acting under an impersonation session, capture the real admin
  impersonatorId String?     @db.Uuid
  at             DateTime    @default(now())

  org       Organization? @relation(fields: [orgId], references: [id])
  byProfile Profile?      @relation("AuditActor", fields: [byProfileId], references: [id])

  @@index([orgId])
  @@index([entity, entityId])
  @@index([byProfileId])
  @@index([at])
}
