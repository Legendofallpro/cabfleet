// CabFleet Prisma schema
// See plan: src/.cursor/plans/cabfleet_architecture_plan_*.plan.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// Enums
// =========================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  DRIVER
  CUSTOMER
}

enum DriverStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  INACTIVE
}

enum DriverVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  INACTIVE
}

enum VehicleType {
  SEDAN
  SUV
  HATCHBACK
  MINIVAN
  LUXURY
  TEMPO
  OTHER
}

enum StaffDesignation {
  MANAGER
  DISPATCHER
  SUPPORT
  ACCOUNTANT
  OTHER
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  STATUS_CHANGE
  ASSIGN
  UNASSIGN
  CLAIM
  CANCEL
  COMPLETE
}

// Booking enums (Phase 2, defined now to avoid migrations later)
enum BookingStatus {
  PENDING
  OPEN_FOR_CLAIM
  CLAIMED
  ASSIGNED
  DRIVER_EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
  NO_SHOW
}

enum DispatchMode {
  MANUAL
  CLAIM
  HYBRID
}

// =========================================================
// Tenant scoping
// =========================================================

// Top-level tenant. Every tenant-scoped row carries `orgId` and is filtered by
// the Prisma extension in src/lib/db.ts. Profile.orgId is intentionally nullable
// so SUPER_ADMIN profiles can act across orgs (enforced via a CHECK constraint
// added in the W1 migration). See [docs/architecture.md] §13 Phase 7 and the
// W1 section of the Phase 7 plan.
model Organization {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches           Branch[]
  profiles           Profile[]
  drivers            Driver[]
  staff              Staff[]
  customers          Customer[]
  vehicles           Vehicle[]
  vehicleAssignments VehicleAssignment[]
  bookingTypes       BookingType[]
  bookings           Booking[]
  pricingRules       PricingRule[]
  dispatchRules      DispatchRule[]
  payments           Payment[]
  invoices           Invoice[]
  shifts             Shift[]
  attendance         Attendance[]
  fuelLogs           FuelLog[]
  expenses           Expense[]
  maintenanceLogs    MaintenanceLog[]
  assignmentHistory  AssignmentHistory[]
  auditLogs          AuditLog[]

  @@index([deletedAt])
}

model Branch {
  id              String       @id @default(cuid())
  orgId           String?
  name            String
  code            String       @unique
  timezone        String       @default("UTC")
  address         String?
  phone           String?
  email           String?
  // Default dispatch mode for bookings in this branch (overridable per BookingType / rule)
  defaultDispatch DispatchMode @default(MANUAL)
  active          Boolean      @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org           Organization?  @relation(fields: [orgId], references: [id])
  profiles      Profile[]
  vehicles      Vehicle[]
  bookings      Booking[]
  pricingRules  PricingRule[]
  dispatchRules DispatchRule[]
  shifts        Shift[]

  @@index([orgId])
  @@index([active])
  @@index([deletedAt])
}

// =========================================================
// Identity
// =========================================================

// Mirrors Supabase auth.users 1:1. Synced via a Postgres trigger
// (see prisma/sql/01_profile_sync.sql).
model Profile {
  // Equal to auth.users.id (Supabase UUID)
  id        String  @id @db.Uuid
  // Null only for SUPER_ADMIN (cross-org platform admins). Enforced by a CHECK
  // constraint added in the W1 migration: orgId IS NOT NULL OR role = 'SUPER_ADMIN'.
  orgId     String?
  email     String  @unique
  fullName  String?
  phone     String?
  avatarUrl String?
  role      Role    @default(CUSTOMER)
  branchId  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org       Organization? @relation(fields: [orgId], references: [id])
  branch    Branch?       @relation(fields: [branchId], references: [id])
  driver    Driver?
  staff     Staff?
  customer  Customer?
  auditLogs AuditLog[]    @relation("AuditActor")

  // Bookings/assignments created/owned by this profile
  bookingsCreated   Booking[]           @relation("BookingCreatedBy")
  bookingsAssigned  Booking[]           @relation("BookingAssignedBy")
  assignmentHistory AssignmentHistory[]
  paymentsCreated   Payment[]           @relation("PaymentCreatedBy")
  attendance        Attendance[]
  expenses          Expense[]

  @@index([orgId])
  @@index([role])
  @@index([branchId])
  @@index([deletedAt])
}

// =========================================================
// Driver
// =========================================================

model Driver {
  id            String                   @id @default(cuid())
  orgId         String?
  profileId     String                   @unique @db.Uuid
  licenseNumber String                   @unique
  licenseExpiry DateTime
  status        DriverStatus             @default(ACTIVE)
  verification  DriverVerificationStatus @default(UNVERIFIED)
  rating        Float?
  totalTrips    Int                      @default(0)
  notes         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org                Organization?       @relation(fields: [orgId], references: [id])
  profile            Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  vehicleAssignments VehicleAssignment[]
  claimedBookings    Booking[]           @relation("BookingClaimedBy")
  assignedBookings   Booking[]           @relation("BookingAssignedDriver")
  fuelLogs           FuelLog[]

  @@index([orgId])
  @@index([status])
  @@index([verification])
  @@index([deletedAt])
}

// =========================================================
// Staff
// =========================================================

model Staff {
  id          String           @id @default(cuid())
  orgId       String?
  profileId   String           @unique @db.Uuid
  employeeId  String           @unique
  designation StaffDesignation @default(SUPPORT)
  status      StaffStatus      @default(ACTIVE)
  hiredAt     DateTime         @default(now())
  notes       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org     Organization? @relation(fields: [orgId], references: [id])
  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  shifts  Shift[]

  @@index([orgId])
  @@index([status])
  @@index([designation])
  @@index([deletedAt])
}

// =========================================================
// Customer
// =========================================================

model Customer {
  id            String  @id @default(cuid())
  orgId         String?
  profileId     String  @unique @db.Uuid
  address       String?
  defaultPickup String?
  loyaltyTier   String?
  totalBookings Int     @default(0)
  totalSpend    Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org      Organization? @relation(fields: [orgId], references: [id])
  profile  Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([orgId])
  @@index([deletedAt])
}

// =========================================================
// Vehicles
// =========================================================

model Vehicle {
  id                 String        @id @default(cuid())
  orgId              String?
  branchId           String
  registrationNumber String        @unique
  make               String
  model              String
  year               Int
  color              String?
  type               VehicleType   @default(SEDAN)
  capacity           Int           @default(4)
  status             VehicleStatus @default(AVAILABLE)
  insuranceExpiry    DateTime?
  fitnessExpiry      DateTime?
  pucExpiry          DateTime?
  odometer           Int           @default(0)
  notes              String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org              Organization?       @relation(fields: [orgId], references: [id])
  branch           Branch              @relation(fields: [branchId], references: [id])
  assignments      VehicleAssignment[]
  assignedBookings Booking[]           @relation("BookingAssignedVehicle")
  fuelLogs         FuelLog[]
  expenses         Expense[]
  maintenanceLogs  MaintenanceLog[]

  @@index([orgId])
  @@index([branchId])
  @@index([status])
  @@index([deletedAt])
}

model VehicleAssignment {
  id        String    @id @default(cuid())
  orgId     String?
  driverId  String
  vehicleId String
  validFrom DateTime  @default(now())
  validTo   DateTime?

  org     Organization? @relation(fields: [orgId], references: [id])
  driver  Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([validTo])
}

// =========================================================
// Bookings (Phase 2; schema seeded now for stability)
// =========================================================

model BookingType {
  id                  String       @id @default(cuid())
  orgId               String?
  name                String       @unique
  description         String?
  defaultDispatchMode DispatchMode @default(MANUAL)
  active              Boolean      @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org           Organization?  @relation(fields: [orgId], references: [id])
  pricingRules  PricingRule[]
  dispatchRules DispatchRule[]
  bookings      Booking[]

  @@index([orgId])
}

model Booking {
  id            String        @id @default(cuid())
  orgId         String?
  branchId      String
  customerId    String
  bookingTypeId String
  status        BookingStatus @default(PENDING)
  dispatchMode  DispatchMode  @default(MANUAL)

  pickupAt      DateTime
  pickupAddress String
  dropAddress   String
  // Geocoded coordinates. Added in W1 (cheaper to ship now than a second
  // migration in W5). Populated by GeocodingService in W5.
  pickupLat     Decimal? @db.Decimal(9, 6)
  pickupLng     Decimal? @db.Decimal(9, 6)
  dropLat       Decimal? @db.Decimal(9, 6)
  dropLng       Decimal? @db.Decimal(9, 6)
  distanceKm    Decimal? @db.Decimal(8, 2)
  passengers    Int      @default(1)

  // Claim
  claimTimeoutAt    DateTime?
  claimedAt         DateTime?
  claimedByDriverId String?

  // Assignment
  assignedAt        DateTime?
  assignedByStaffId String?   @db.Uuid
  assignedDriverId  String?
  assignedVehicleId String?

  // Money
  fareEstimate Decimal? @db.Decimal(10, 2)
  fareFinal    Decimal? @db.Decimal(10, 2)

  // Concurrency control (optimistic locking; incremented on every transition)
  version Int @default(0)

  createdById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org               Organization?       @relation(fields: [orgId], references: [id])
  branch            Branch              @relation(fields: [branchId], references: [id])
  customer          Customer            @relation(fields: [customerId], references: [id])
  bookingType       BookingType         @relation(fields: [bookingTypeId], references: [id])
  claimedBy         Driver?             @relation("BookingClaimedBy", fields: [claimedByDriverId], references: [id])
  assignedDriver    Driver?             @relation("BookingAssignedDriver", fields: [assignedDriverId], references: [id])
  assignedVehicle   Vehicle?            @relation("BookingAssignedVehicle", fields: [assignedVehicleId], references: [id])
  assignedBy        Profile?            @relation("BookingAssignedBy", fields: [assignedByStaffId], references: [id])
  createdBy         Profile?            @relation("BookingCreatedBy", fields: [createdById], references: [id])
  assignmentHistory AssignmentHistory[]
  payments          Payment[]
  invoice           Invoice?

  @@index([orgId])
  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([pickupAt])
  @@index([deletedAt])
}

model AssignmentHistory {
  id          String      @id @default(cuid())
  orgId       String?
  bookingId   String
  driverId    String?
  vehicleId   String?
  action      AuditAction
  byProfileId String?     @db.Uuid
  reason      String?
  at          DateTime    @default(now())

  org       Organization? @relation(fields: [orgId], references: [id])
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  byProfile Profile?      @relation(fields: [byProfileId], references: [id])

  @@index([orgId])
  @@index([bookingId])
  @@index([at])
}

// =========================================================
// Pricing
// =========================================================

model PricingRule {
  id            String    @id @default(cuid())
  orgId         String?
  bookingTypeId String
  branchId      String?
  baseFare      Decimal   @default(0) @db.Decimal(10, 2)
  perKm         Decimal   @default(0) @db.Decimal(10, 2)
  perMin        Decimal   @default(0) @db.Decimal(10, 2)
  surgeJson     Json?
  validFrom     DateTime  @default(now())
  validTo       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org         Organization? @relation(fields: [orgId], references: [id])
  bookingType BookingType   @relation(fields: [bookingTypeId], references: [id])
  branch      Branch?       @relation(fields: [branchId], references: [id])

  @@index([orgId])
  @@index([bookingTypeId])
  @@index([branchId])
  @@index([validFrom, validTo])
}

// =========================================================
// Dispatch policy
// =========================================================

model DispatchRule {
  id              String       @id @default(cuid())
  orgId           String?
  priority        Int          @default(100) // lower = higher priority
  branchId        String?
  bookingTypeId   String?
  customerSegment String? // free-form tag for now (e.g. "corporate", "loyalty:gold")
  mode            DispatchMode
  params          Json? // e.g. { "hybridTimeoutMins": 5 }
  active          Boolean      @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org         Organization? @relation(fields: [orgId], references: [id])
  branch      Branch?       @relation(fields: [branchId], references: [id])
  bookingType BookingType?  @relation(fields: [bookingTypeId], references: [id])

  @@index([orgId])
  @@index([priority])
  @@index([active])
}

// =========================================================
// Payments (Phase 5)
// =========================================================

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

model Payment {
  id          String        @id @default(cuid())
  orgId       String?
  bookingId   String
  amount      Decimal       @db.Decimal(10, 2)
  method      String        // e.g. "CASH", "CARD", "UPI"
  status      PaymentStatus @default(PENDING)
  txnRef      String?
  capturedAt  DateTime?
  createdById String?       @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org       Organization? @relation(fields: [orgId], references: [id])
  booking   Booking       @relation(fields: [bookingId], references: [id])
  createdBy Profile?      @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([orgId])
  @@index([bookingId])
  @@index([status])
  @@index([deletedAt])
}

// =========================================================
// Invoices (Phase 5)
// =========================================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

model Invoice {
  id        String        @id @default(cuid())
  orgId     String?
  bookingId String        @unique
  number    String        @unique
  pdfUrl    String?
  issuedAt  DateTime      @default(now())
  dueAt     DateTime?
  status    InvoiceStatus @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  org     Organization? @relation(fields: [orgId], references: [id])
  booking Booking       @relation(fields: [bookingId], references: [id])

  @@index([orgId])
  @@index([status])
  @@index([issuedAt])
  @@index([deletedAt])
}

// =========================================================
// Operations (Phase 6)
// =========================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

model Attendance {
  id        String           @id @default(cuid())
  orgId     String?
  profileId String           @db.Uuid
  date      DateTime         @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  status    AttendanceStatus @default(PRESENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id])
  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@index([orgId])
  @@index([profileId])
  @@index([date])
}

model Shift {
  id       String   @id @default(cuid())
  orgId    String?
  branchId String
  staffId  String?
  startsAt DateTime
  endsAt   DateTime
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization? @relation(fields: [orgId], references: [id])
  branch Branch        @relation(fields: [branchId], references: [id])
  staff  Staff?        @relation(fields: [staffId], references: [id])

  @@index([orgId])
  @@index([branchId])
  @@index([staffId])
  @@index([startsAt])
}

model FuelLog {
  id        String   @id @default(cuid())
  orgId     String?
  vehicleId String
  driverId  String?
  litres    Decimal  @db.Decimal(8, 2)
  amount    Decimal  @db.Decimal(10, 2)
  odometer  Int
  notes     String?
  at        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id])
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id])
  driver  Driver?       @relation(fields: [driverId], references: [id])

  @@index([orgId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([at])
}

model Expense {
  id         String   @id @default(cuid())
  orgId      String?
  profileId  String?  @db.Uuid
  vehicleId  String?
  category   String   // e.g. "MAINTENANCE", "FUEL", "TOLL", "MISC"
  amount     Decimal  @db.Decimal(10, 2)
  receiptUrl String?
  notes      String?
  at         DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id])
  profile Profile?      @relation(fields: [profileId], references: [id])
  vehicle Vehicle?      @relation(fields: [vehicleId], references: [id])

  @@index([orgId])
  @@index([profileId])
  @@index([vehicleId])
  @@index([at])
}

model MaintenanceLog {
  id              String   @id @default(cuid())
  orgId           String?
  vehicleId       String
  type            String   // e.g. "SERVICE", "TYRE", "OIL_CHANGE", "REPAIR"
  cost            Decimal  @db.Decimal(10, 2)
  odometer        Int
  nextDueOdometer Int?
  notes           String?
  at              DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id])
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id])

  @@index([orgId])
  @@index([vehicleId])
  @@index([at])
}

// =========================================================
// Audit log (immutable; written by every mutation service)
// =========================================================

model AuditLog {
  id             String      @id @default(cuid())
  orgId          String?
  entity         String // "Booking", "Vehicle", ...
  entityId       String
  action         AuditAction
  diff           Json?
  byProfileId    String?     @db.Uuid
  // If acting under an impersonation session, capture the real admin
  impersonatorId String?     @db.Uuid
  at             DateTime    @default(now())

  org       Organization? @relation(fields: [orgId], references: [id])
  byProfile Profile?      @relation("AuditActor", fields: [byProfileId], references: [id])

  @@index([orgId])
  @@index([entity, entityId])
  @@index([byProfileId])
  @@index([at])
}
