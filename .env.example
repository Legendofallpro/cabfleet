# Copy to `.env.local` for local development:
#   cp .env.example .env.local
# Both Next.js and Prisma's CLI will read .env.local (prisma.config.ts is
# wired to load it). For deployment, set these as environment variables in
# Vercel instead.

# ---------- Supabase ----------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # never commit; never bundle to the client

# ---------- Database ----------
# Project Settings -> Database -> Connection string -> URI
#
# IMPORTANT: passwords with special characters (@ # ? / : % & + =) must be
# URL-encoded, OR reset the DB password to plain alphanumerics.
#
# DATABASE_URL = Transaction-mode pooler (port 6543). Used by the app at runtime.
DATABASE_URL="postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = Session-mode pooler (port 5432). Used by `prisma migrate`.
# Required because Transaction-mode pooler does not support prepared statements.
DIRECT_URL="postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------- App ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# ---------- Cron ----------
# Required in production (the app refuses to boot without it — see src/lib/env.ts).
# Vercel sets this automatically in production. For local testing, set any value.
CRON_SECRET="your-secret-here"

# ---------- Rate limiting (optional) ----------
# When set, a shared Upstash Redis backs the rate limiter (multi-instance safe).
# When unset, the limiter falls back to per-process in-memory buckets.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------- Email (Resend) ----------
# Get a key from https://resend.com/api-keys
# Optional: if absent, invoice emails are silently skipped (warning logged).
RESEND_API_KEY=""

# First-run. Optional locally. Set in production so a public URL cannot complete setup.
SETUP_SECRET=""

# CI / Playwright only. When set, prisma/seed.ts writes a completed InstallSettings row.
INSTALL_COUNTRY="IN"
INSTALL_CURRENCY="INR"
INSTALL_LOCALE="en-IN"
INSTALL_TIMEZONE="Asia/Kolkata"
INSTALL_PHONE_REGION="IN"
INSTALL_TAX_ID_LABEL="GSTIN"
INSTALL_TAX_RATE="0"

# Invoice / notification From header
MAIL_FROM="CabFleet <noreply@localhost>"

# ---------- Notifications (outbox drain) ----------
# Master switch for /api/cron/drain-notifications. Off = enqueue only, no send.
NOTIFICATIONS_ENABLED="false"
# WhatsApp via Twilio. Any missing value makes the provider no-op.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
# TWILIO_ALLOWED_COUNTRIES="IN"
# TWILIO_PER_RECIPIENT_LIMIT="10:3600"

# ---------- Auth ----------
# Secret for signing the password-setup proof cookie (invite/recovery flow).
# Must be at least 32 characters of random data. Generate with:
#   openssl rand -base64 32
AUTH_PROOF_SECRET="change-me-to-at-least-32-chars-of-random-data"

# ---------- Support ----------
# Optional platform support address shown on /support
SUPPORT_EMAIL="support@cabfleet.com"

# Set to "true" to bypass env validation during build (CI without secrets, etc.)
SKIP_ENV_VALIDATION="false"

# Staff/admin sessions require authenticator AAL2. Playwright sets this false.
STAFF_AAL2_REQUIRED="true"

# Redirect to /setup until InstallSettings is complete. Production leaves unset (true).
# CI sets false so build and Playwright run without Postgres.
INSTALL_GATE="true"

# Multi-tenant org filter. Keep false until a second org is real; Prisma still
# binds the session org in production either way.
MULTI_ORG_ENABLED="false"

# Live GPS map + private Realtime. Leave false until prisma/sql/15_realtime_private_trip.sql
# and the Supabase Realtime authorization toggle are applied.
REALTIME_TRACKING_ENABLED="false"

# Optional MapLibre raster tiles for the customer live map (server action still
# geocodes with MAPBOX_ACCESS_TOKEN; this URL is only for tiles).
NEXT_PUBLIC_MAP_TILES_URL=""

# Optional. Server-only. Geocodes typed pickup/drop and can fill distanceKm.
# Unset = today's behaviour (manual km, operator confirms fare).
MAPBOX_ACCESS_TOKEN=""

# CORS allow-list for /api/v1 (mobile app Origin). Unset = no CORS headers.
MOBILE_APP_ORIGIN=""

# Optional Playwright live specs (desk-book + trip-loop). Leave unset to skip.
# E2E_STAFF_EMAIL=""
# E2E_STAFF_PASSWORD=""
# E2E_CUSTOMER_EMAIL=""
# E2E_CUSTOMER_PASSWORD=""
# E2E_DRIVER_EMAIL=""
# E2E_DRIVER_PASSWORD=""
