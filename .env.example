# Copy to `.env.local` for local development:
#   cp .env.example .env.local
# Both Next.js and Prisma's CLI will read .env.local (prisma.config.ts is
# wired to load it). For deployment, set these as environment variables in
# Vercel instead.

# ---------- Supabase ----------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # never commit; never bundle to the client

# ---------- Database ----------
# Project Settings -> Database -> Connection string -> URI
#
# IMPORTANT: passwords with special characters (@ # ? / : % & + =) must be
# URL-encoded, OR reset the DB password to plain alphanumerics.
#
# DATABASE_URL = Transaction-mode pooler (port 6543). Used by the app at runtime.
DATABASE_URL="postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = Session-mode pooler (port 5432). Used by `prisma migrate`.
# Required because Transaction-mode pooler does not support prepared statements.
DIRECT_URL="postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------- App ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# ---------- Cron ----------
# Vercel sets this automatically in production. For local testing, set any value.
CRON_SECRET="your-secret-here"

# ---------- Email (Resend) ----------
# Get a key from https://resend.com/api-keys
# Optional: if absent, invoice emails are silently skipped (warning logged).
RESEND_API_KEY=""

# ---------- Auth ----------
# Secret for signing the password-setup proof cookie (invite/recovery flow).
# Must be at least 32 characters of random data. Generate with:
#   openssl rand -base64 32
AUTH_PROOF_SECRET="change-me-to-at-least-32-chars-of-random-data"

# Set to "true" to bypass env validation during build (CI without secrets, etc.)
SKIP_ENV_VALIDATION="false"
