{
  "name": "cabfleet",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:csp": "playwright test e2e/csp.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "load-test:claim": "npx tsx scripts/load-test-claim.ts",
    "setup:avatar-bucket": "tsx scripts/setup-avatar-bucket.ts",
    "check:tokens": "tsx scripts/check-ui-tokens.ts",
    "check:structure": "tsx scripts/check-structure.ts && tsx scripts/check-rls-coverage.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.17",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "autoprefixer": "^10.4.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.3",
    "maplibre-gl": "^5.24.0",
    "next": "^16.1.6",
    "nuqs": "^2.8.9",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "razorpay": "^2.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.76.1",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.2.2",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/react-transition-group": "^4.4.12",
    "@vitest/ui": "^4.1.7",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.7",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
